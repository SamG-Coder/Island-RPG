<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <InformationalVersion>0.4.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Island RPG Dedicated Server</AssemblyTitle>
    <Product>Island RPG</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IslandRpg.Core\IslandRpg.Core.csproj" />
    <ProjectReference Include="..\IslandRpg.Protocol\IslandRpg.Protocol.csproj" />
    <ProjectReference Include="..\IslandRpg.Simulation\IslandRpg.Simulation.csproj" />
  </ItemGroup>
</Project>
